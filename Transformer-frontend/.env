# API Configuration
# VITE_BACKEND_URL: The actual URL of your backend server.
# VITE_API_BASE_URL: The prefix for API calls. Set to "/api" to use the Vite proxy (fixes CORS).

# 1. Local Environment
VITE_BACKEND_URL=http://localhost:8080

# 2. Live Environment
# VITE_BACKEND_URL=http://192.168.15.228:8080

# API Base URL - Set to /api to use the proxy defined in vite.config.ts
VITE_API_BASE_URL=

# Service Prefixes
VITE_AUTH_SERVICE_PREFIX=/auth-service
VITE_TRANSFORMER_SERVICE_PREFIX=/transformer-service
