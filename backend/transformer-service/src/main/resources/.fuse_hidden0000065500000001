remote.transformer.lookup.url=${REMOTE_TRANSFORMER_LOOKUP_URL:http://68.183.126.109:3001/api/transformer/details}

# --- Performance ---
# Load lazy collections in batches (one IN query instead of one query per row: avoids N+1)
spring.jpa.properties.hibernate.default_batch_fetch_size=50
# Group inserts/updates into JDBC batches
spring.jpa.properties.hibernate.jdbc.batch_size=50
spring.jpa.properties.hibernate.order_inserts=true
spring.jpa.properties.hibernate.order_updates=true
# Redis second-level cache: on when REDIS_HOST is set (docker-compose sets it); off = in-memory caches only
redis.host=${REDIS_HOST:}
redis.port=${REDIS_PORT:6379}
redis.password=${REDIS_PASSWORD:}
redis.key-prefix=${REDIS_KEY_PREFIX:tms}
# Scheduled jobs run on their own small pool, so one slow job (e.g. a LORIOT call) cannot stop the others.
spring.task.scheduling.pool.size=4
# Default positions LORIOT reports for gateways whose location was never set ("lat,lon;lat,lon"): treated as no location.
loriot.placeholder-locations=${LORIOT_PLACEHOLDER_LOCATIONS:46.807689,7.100528}
