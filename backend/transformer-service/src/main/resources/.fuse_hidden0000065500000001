spring.application.name=transformer-service
spring.cloud.config.enabled=true

server.port=8083
# gzip JSON responses (lists and dashboards shrink ~80%)
server.compression.enabled=true
server.compression.mime-types=application/json,text/plain
server.compression.min-response-size=2048

# Fallback JWT Configuration
application.security.jwt.secret-key=w7rj85o9SnDk1q2W8gHixMfNYaW6mDpcFXH0f1RmZDU=
application.security.jwt.expiration=18000000
application.security.jwt.cookie-name=jwt-cookie

# Database Configuration (Fallback)
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.url=jdbc:mysql://localhost:3306/tms
spring.datasource.username=root
spring.datasource.password=secret
spring.jpa.hibernate.ddl-auto=update
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.jackson.time-zone=Africa/Harare

# Eureka (Fallback)
eureka.client.service-url.defaultZone=${EUREKA_URI:http://localhost:8761/eureka}
eureka.instance.prefer-ip-address=true
# eureka.instance.ip-address=10.167.155.205
eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true

# Swagger
springdoc.swagger-ui.disable-swagger-default-url=true
springdoc.swagger-ui.url=/transformer/v3/api-docs
springdoc.swagger-ui.config-url=/transformer/v3/api-docs/swagger-config

# WebSocket Configuration
loriot.ws.enabled=true
oculus.ws.enabled=true
oculus.ws.url=wss://lorawan.powertel.co.zw/app?token=vgEACwAAABZsb3Jhd2FuLnBvd2VydGVsLmNvLnp3tjYlRffQ3aFr1wWcT9O_hA==
oculus.ws.log=true
oculus.ws.insecure-ssl=${LORIOT_INSECURE_SSL:true}
oculus.loriot.api-url=${LORIOT_API_URL:}
oculus.loriot.app-id=${LORIOT_APP_ID:}
oculus.loriot.api-key=${LORIOT_API_KEY:}
oculus.loriot.downlink-port=${LORIOT_DOWNLINK_PORT:2}
oculus.loriot.downlink-confirmed=${LORIOT_DOWNLINK_CONFIRMED:false}
